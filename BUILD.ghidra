# The Ghidra decompiler builds three native executables we want to alter.
#  * decompile - the decompiler subprocess accessed by Ghidra"s Java front end.  This gets installed at
#    `.../ghidra_11.4_DEV/Ghidra/Features/Decompiler/os/linux_x86_64/decompile`.
#  * decompile_unittest - a decompiler unit test framework
#  * decompile_datatest - a decompiler console used in data tests and plugin development
# Derived from Ghidra/Features/Decompiler/src/decompile/cpp/Makefile and Ghidra/Features/Decompiler/buildNatives.gradle

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

# decompiler source file location in the imported Ghidra release tar file
SRCDIR = "Ghidra/Features/Decompiler/src/decompile/cpp/"

# The decompiler usually builds with c++-11, but we want something with a bit more utility.
# This update allows better log formatting and standard C++ vector handling.
CPP_STANDARD = "c++20"

# Test with a command like:
#     bazelisk build -c dbg @ghidra//:decompile @ghidra//:decompile_datatest plugins/riscv_vector @ghidra//:decompile_unittest

# Most decompiler library files have .hh and .cc components:
DECOMP_LIB_ROOTS = [
    "action",  # DECCORE
    "address",  # CORE
    "architecture",  # DECCORE
    "bitfield",  # DECCORE
    "block",  # DECCORE
    "blockaction",  # DECCORE
    "capability",  # DECCORE
    "cast",  # DECCORE
    "comment",  # DECCORE
    "condexe",  # DECCORE
    "constseq",  # DECCORE
    "coreaction",  # DECCORE
    "cover",  # DECCORE
    "cpool",  # DECCORE
    "crc32",  # DECCORE
    "database",  # DECCORE
    "double",  # DECCORE
    "dynamic",  # DECCORE
    "emulate",  # DECCORE
    "emulateutil",  # DECCORE
    "expression",  # DECCORE
    "float",  # CORE
    "flow",  # DECCORE
    "fspec",  # DECCORE
    "funcdata",  # DECCORE
    "globalcontext",  # CORE
    "graph",  # DECCORE
    "heritage",  # DECCORE
    "jumptable",  # DECCORE
    "loadimage",  # DECCORE
    "marshal",  # CORE
    "memstate",  # DECCORE
    "merge",  # DECCORE
    "metatype",  # CORE
    "modelrules",  # DECCORE
    "multiprecision",  # DECCORE
    "op",  # DECCORE
    "opbehavior",  # DECCORE
    "opcodes",  # CORE
    "options",  # DECCORE
    "override",  # DECCORE
    "paramid",  # DECCORE
    "pcodeinject",  # DECCORE
    "pcoderaw",  # CORE
    "plugin_manager",
    "prefersplit",  # DECCORE
    "prettyprint",  # DECCORE
    "printc",  # DECCORE
    "printjava",  # DECCORE
    "printlanguage",  # DECCORE
    "rangeutil",  # DECCORE
    "ruleaction",  # DECCORE
    "signature",  # DECCORE
    "space",  # CORE
    "stringmanage",  # DECCORE
    "subflow",  # DECCORE
    "transform",  # DECCORE
    "translate",  # CORE
    "type",  # DECCORE
    "typeop",  # DECCORE
    "unionresolve",  # DECCORE
    "userop",  # DECCORE
    "variable",  # DECCORE
    "varmap",  # DECCORE
    "varnode",  # DECCORE
    "xml",  # CORE
]

# Some decomp library files only exist in the .hh form
DECOMP_LIB_HH_ONLY = [
    "compression",
    "context",
    "error",
    "filemanage",
    "grammar",
    "partmap",
    "rangemap",
    "semantics",
    "slaformat",
    "sleigh",
    "sleigh_arch",
    "sleighbase",
    "slghpatexpress",
    "slghpattern",
    "slghsymbol",
]

# Some decomp library files only exist in the .cc form
DECOMP_LIB_CC_ONLY = [
    "funcdata_block",
    "funcdata_op",
    "funcdata_varnode",
]

# generate lists of all decomp lib CC and HHfiles
DECOMP_CC_FILES = DECOMP_LIB_ROOTS + DECOMP_LIB_CC_ONLY
DECOMP_HH_FILES = DECOMP_LIB_ROOTS + DECOMP_LIB_HH_ONLY

# Build rules for common source files
# Note: only those headers declared under `hdrs` will be visible to plugin builds.
cc_library(
    name = "decomp_lib",
    srcs = [SRCDIR + f + ".cc" for f in DECOMP_CC_FILES],
    hdrs = [SRCDIR + f + ".hh" for f in DECOMP_HH_FILES] + [
        SRCDIR + "types.h",
    ],
    copts = [
        "-Wall",
        "-Wno-sign-compare",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@spdlog",
    ],
)

# The decompiler process invoked by ghidra and fed via a socket,
# usually installed in a directory like /opt/ghidra_12.3_DEV/Ghidra/Features/Decompiler/os/linux_x86_64
cc_binary(
    name = "decompile",
    srcs = [
        SRCDIR + f
        for f in [
            "comment_ghidra.cc",  # GHIDRA
            "comment_ghidra.hh",  # GHIDRA
            "cpool_ghidra.cc",  # GHIDRA
            "cpool_ghidra.hh",  # GHIDRA
            "database_ghidra.cc",  # GHIDRA
            "database_ghidra.hh",  # GHIDRA
            "ghidra_arch.cc",  # GHIDRA
            "ghidra_arch.hh",  # GHIDRA
            "ghidra_context.cc",  # GHIDRA
            "ghidra_context.hh",  # GHIDRA
            "ghidra_process.cc",  # GHIDRA
            "ghidra_process.hh",  # GHIDRA
            "ghidra_translate.cc",  # GHIDRA
            "ghidra_translate.hh",  # GHIDRA
            "inject_ghidra.cc",  # GHIDRA
            "inject_ghidra.hh",  # GHIDRA
            "loadimage_ghidra.cc",  # GHIDRA
            "loadimage_ghidra.hh",  # GHIDRA
            "signature_ghidra.cc",  # GHIDRA
            "signature_ghidra.hh",  # GHIDRA
            "string_ghidra.cc",  # GHIDRA
            "string_ghidra.hh",  # GHIDRA
            "typegrp_ghidra.cc",  # GHIDRA
            "typegrp_ghidra.hh",  # GHIDRA
        ]
    ],
    copts = [
        "-O2",
        "-Wall",
        "-Wno-sign-compare",
        "-std=" + CPP_STANDARD,
    ],
    linkopts = [
        "-Wl,-export-dynamic",
        "-Wl,-lz",
    ],
    deps = [
        ":decomp_lib",
        "@spdlog",
    ],
)

# The unit test and datatest executables share a number of source files, grouped together here
TEST_SRCS = [
    "callgraph.cc",  # GHIDRA_NAMES_DBG
    "callgraph.hh",  # GHIDRA_NAMES_DBG
    "compression.cc",  # SLEIGH
    "context.cc",  # SLEIGH
    "filemanage.cc",  # SLEIGH
    "grammar.cc",  # DECCORE
    "ifacedecomp.cc",  # GHIDRA_NAMES_DBG
    "ifacedecomp.hh",  # GHIDRA_NAMES_DBG
    "ifaceterm.hh",  # GHIDRA_NAMES_DBG
    "ifaceterm.cc",  # GHIDRA_NAMES_DBG
    "inject_sleigh.cc",
    "inject_sleigh.hh",
    "interface.cc",  # GHIDRA_NAMES_DBG
    "interface.hh",  # GHIDRA_NAMES_DBG
    "libdecomp.cc",
    "libdecomp.hh",
    "pcodecompile.cc",  # SLEIGH
    "pcodecompile.hh",  # SLEIGH
    "pcodeparse.cc",  # SLEIGH
    "pcodeparse.hh",  # SLEIGH
    "semantics.cc",  # SLEIGH
    "slaformat.cc",  # SLEIGH
    "slaformat.hh",  # SLEIGH
    "sleigh.cc",  # SLEIGH
    "sleigh.hh",  # SLEIGH
    "sleighbase.cc",  # SLEIGH
    "sleigh_arch.cc",
    "sleigh_arch.hh",
    "slghpatexpress.cc",  # SLEIGH
    "slghpattern.cc",  # SLEIGH
    "slghsymbol.cc",  # SLEIGH
    "testfunction.cc",  # GHIDRA_NAMES_DBG
    "testfunction.hh",  # GHIDRA_NAMES_DBG
]

# Source files only used by unit tests
UNIT_TEST_SRCS = [
    "test.cc",
    "test.hh",
]

# Source files only used by data tests
DATA_TEST_SRCS = [
    "loadimage_xml.cc",
    "loadimage_xml.hh",
    "slghsymbol.hh",
    "consolemain.cc",
    "xml_arch.cc",
    "xml_arch.hh",
]

# Test library of common files only used in testing
cc_library(
    name = "test_lib",
    srcs = [SRCDIR + f for f in TEST_SRCS],
    copts = [
        "-Wall",
        "-Wno-sign-compare",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":decomp_lib",
        "@spdlog",
    ],
)

# Unit test framework - not routinely exercises here
cc_binary(
    name = "decompile_unittest",
    srcs = [
        SRCDIR + f
        for f in UNIT_TEST_SRCS
    ],
    copts = [
        "-O2",
        "-Wall",
        "-Wno-sign-compare",
        "-std=" + CPP_STANDARD,
    ],
    defines = [
        "__TERMINAL__",
    ],
    linkopts = [
        "-Wl,-export-dynamic",
        "-Wl,-lz",
    ],
    deps = [
        ":decomp_lib",
        ":test_lib",
        "@spdlog",
    ],
)

# decompiler console interface for data tests
cc_binary(
    name = "decompile_datatest",
    srcs = [
        SRCDIR + f
        for f in DATA_TEST_SRCS
    ],
    copts = [
        "-O2",
        "-Wall",
        "-Wno-sign-compare",
        "-std=" + CPP_STANDARD,
    ],
    defines = [
        "__TERMINAL__",
    ],
    linkopts = [
        "-Wl,-export-dynamic",
        "-Wl,-lz",
    ],
    deps = [
        ":decomp_lib",
        ":test_lib",
        "@spdlog",
    ],
)
